{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./plugin",
    "declaration": false,
    "noEmit": false,
    "outDir": "./.plugin-build"
  },
  "include": ["plugin/**/*.ts"]
}