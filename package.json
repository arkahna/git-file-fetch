{
  "name": "@arkahna/git-file-fetch",
  "version": "0.1.0",
  "description": "Fetch specific files from remote git repos and track them locally.",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "git-file-fetch": "src/index.js"
  },
  "scripts": {
    "start": "ts-node --esm src/index.ts",
    "build": "npx tsc -p tsconfig.json && npx tsc -p tsconfig.plugin.json && pnpm run build:plugin-assets",
    "build:plugin-assets": "node -e \"require('fs').copyFileSync('plugin/executors.json', 'plugin/executors.json')\" && node -e \"require('fs').copyFileSync('plugin/executors/fetch/schema.json', 'plugin/executors/fetch/schema.json')\"",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test:smoke": "node src/index.js \"https://github.com/octokit/core.js.git@main:LICENSE\" --dry-run --json",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "git",
    "file",
    "fetch",
    "devtool",
    "remote",
    "cli"
  ],
  "author": "Arkahna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkahna/git-file-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/arkahna/git-file-fetch/issues"
  },
  "homepage": "https://github.com/arkahna/git-file-fetch#readme",
  "executors": "./plugin/executors.json",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "files": [
    "src/**/*.js",
    "plugin"
  ],
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
